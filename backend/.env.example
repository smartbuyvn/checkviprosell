# ─── Viprosell Backend — Environment Template ────────────────────────────────
# Copy file này thành backend/.env và điền giá trị thật.
# File này an toàn để commit lên git — KHÔNG chứa giá trị thật.
# File backend/.env đã được gitignore — tuyệt đối không commit file thật.

# ─── Backend URLs & CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8080,https://v.ninhle.com
VITE_APP_BASE_URL=https://v.ninhle.com
BACKEND_PUBLIC_BASE_URL=https://v.ninhle.com/api/v1
PORT=3001

# ─── Supabase Cloud ───────────────────────────────────────────────────────────
# Lấy từ: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key_here
# ⚠️ SERVICE_ROLE_KEY có quyền bypass RLS — tuyệt đối không để lộ

# ─── Chặn SSRF cho ảnh người dùng (S1-1) ──────────────────────────────────────
# Danh sách host mà worker được phép tải ảnh về, cách nhau bằng dấu phẩy.
# Khớp cả subdomain: "supabase.co" cho phép "abcxyz.supabase.co".
# Host của SUPABASE_URL được tự thêm, không cần khai lại.
# ⚠️ FAIL-CLOSED: bỏ trống thì MỌI URL ngoài bị từ chối và render sẽ hỏng.
#    IP nội bộ (127.x, 10.x, 192.168.x, 169.254.169.254, ::1, fc00::/7) luôn bị chặn,
#    kể cả khi được khai ở đây.
ALLOWED_ASSET_HOSTS=

# ─── Redis (Remote VPS) ───────────────────────────────────────────────────────
# Format: redis://:PASSWORD@HOST:PORT/DB_INDEX
# Viprosell dùng DB index 1 (NOVA dùng DB 0)
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@vps.ninhle.com:6379/1

# ─── Ollama (Local LLM — Hybrid local-first) ───────────────────────────────────
# Dedicated Viprosell instance pinned to GPU 1 (RTX 3060 Ti 8GB), port 11435.
# Start it with: powershell -File ops/ollama-gpu1.ps1  (does NOT touch the shared instance on 11434)
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=90000
LOCAL_LLM_URL=http://localhost:11435/v1/chat/completions

# ─── Render Pipeline ──────────────────────────────────────────────────────────
RENDER_OUTPUT_DIR=../renders_output
# FFmpeg NVENC runs on GPU 0 (RTX 3060 12GB). ComfyUI (later) also on GPU 0.
FFMPEG_GPU_INDEX=0
FFMPEG_HWACCEL=cuda
FFMPEG_VIDEO_ENCODER=h264_nvenc
FFMPEG_NVENC_PRESET=p4
# Worker reports render status to the API server (credits deducted here).
# Same machine → localhost. Override if API is elsewhere.
RENDER_CALLBACK_URL=http://localhost:3001/api/v1/render/callback

# ─── Google Gemini AI (fallback ONLY when policy allows) ──────────────────────
# Lấy từ: https://aistudio.google.com/apikey
# ⚠️ Không để lộ key này — có thể bị dùng lén tốn tiền
GEMINI_API_KEY=AQ.your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000

# ─── Feature Flags ────────────────────────────────────────────────────────────
LOCAL_ONLY_MODE=false
ALLOW_EXTERNAL_AI_APIS=true
PREMIUM_RENDER_ENABLED=false
DEFAULT_TTS_MODE=placeholder

# ─── Payment — SePay (Nội địa VN) ────────────────────────────────────────────
SEPAY_API_TOKEN=your_sepay_token_here
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_here
SEPAY_BANK_ACC=your_bank_account_number
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NAME=YOUR FULL NAME

# ─── Payment — Lemon Squeezy (Quốc tế) ───────────────────────────────────────
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ─── Internal Security ────────────────────────────────────────────────────────
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Key này bảo vệ upload API — nếu lộ, kẻ xấu giả mạo upload video
INTERNAL_CALLBACK_SECRET=generate_a_random_64_char_hex_here
