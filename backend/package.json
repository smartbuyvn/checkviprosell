{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "worker:ai": "node dist/ai.worker.js",
    "worker:ai:dev": "tsx src/ai.worker.ts",
    "worker:render": "node dist/render.worker.js",
    "worker:render:dev": "tsx src/render.worker.ts",
    "worker:all:dev": "npx concurrently \"npm run worker:ai:dev\" \"npm run worker:render:dev\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@google/genai": "^2.8.0",
    "@supabase/supabase-js": "^2.99.1",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
