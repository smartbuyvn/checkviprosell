# ─── Viprosell Frontend — Environment Template ───────────────────────────────
# Copy file này thành .env và điền giá trị thật.
# File này an toàn để commit lên git — KHÔNG chứa giá trị thật.

# URL Frontend (domain production)
VITE_APP_BASE_URL=https://v.ninhle.com

# URL Backend API
VITE_API_BASE_URL=https://v.ninhle.com/api/v1

# Supabase — ANON key (safe to expose, protected by Row Level Security)
# Lấy từ: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your_anon_key_here

# Local dev override (uncomment khi dev)
# VITE_APP_BASE_URL=http://localhost:8080
# VITE_API_BASE_URL=http://localhost:3001/api/v1
