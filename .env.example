# Viprosell v1.2 Local Development Environment

# --- SUPABASE CONFIGURATION ---
# Note: The local stack relies on a remote Supabase project for Auth & API routing.
# The `docker-compose.dev.yml` only provides fundamental Postgres/Redis, it does NOT provide the full Supabase gateway on port 8000.
VITE_SUPABASE_URL="https://your-remote-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Note: VITE_SUPABASE_PROJECT_ID has been audited and removed as it is entirely unused by the application source.

# --- LOVABLE AI GATEWAY (REQUIRED) ---
LOVABLE_API_KEY="your-lovable-gateway-jwt-here"

# --- BACKEND / ORCHESTRATOR ---
API_PORT=3001
API_HOST="0.0.0.0"

# --- QUEUE CONFIGURATION ---
REDIS_URL="redis://localhost:6379"

# --- PAYMENT PROVIDERS (PLACEHOLDERS) ---
STRIPE_WEBHOOK_SECRET="whsec_mock"
PAYPAL_WEBHOOK_ID="webhook_mock"

# --- OBSERVABILITY ---
SENTRY_DSN=""

# --- PREMIUM FEATURES (MOCKED) ---
FACEFUSION_API_URL="http://localhost:7860/api"
LOCAL_ONLY_MODE="true"
PREMIUM_RENDER_ENABLED="true"
